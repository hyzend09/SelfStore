<Window x:Class="SelfStorage.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Self Storage - Admin" Width="1040" Height="640"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#222B45" Padding="12,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Đăng xuất" Click="Logout_Click"/>
                <StackPanel>
                    <TextBlock x:Name="lblUser" Foreground="White" FontSize="16"/>
                    <TextBlock x:Name="lblStats" Foreground="#BBC" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl>
            <!-- ===== KHO ===== -->
            <TabItem Header="Quản lý kho">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Cơ sở:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cbFilter" Width="200" Margin="6,0,16,0" DisplayMemberPath="Name"
                                  SelectionChanged="Filter_Changed"/>
                        <Button Content="+ Thêm kho" Click="AddUnit_Click"/>
                        <Button Content="Sửa" Click="EditUnit_Click"/>
                        <Button Content="Xóa" Click="DeleteUnit_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="gridUnits" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column"
                              MouseDoubleClick="EditUnit_Click">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Cơ sở" Binding="{Binding FacilityName}" Width="*"/>
                            <DataGridTextColumn Header="Mã kho" Binding="{Binding Code}" Width="100"/>
                            <DataGridTextColumn Header="Loại" Binding="{Binding Type}" Width="110"/>
                            <DataGridTextColumn Header="Diện tích (m²)" Binding="{Binding SizeM2}" Width="110"/>
                            <DataGridTextColumn Header="Giá / tháng" Binding="{Binding PricePerMonth, StringFormat={}{0:N0} ₫}" Width="140"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== CƠ SỞ ===== -->
            <TabItem Header="Cơ sở">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="+ Thêm cơ sở" Click="AddFacility_Click"/>
                        <Button Content="Sửa" Click="EditFacility_Click"/>
                        <Button Content="Xóa" Click="DeleteFacility_Click"/>
                    </StackPanel>
                    <DataGrid x:Name="gridFacilities" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column"
                              MouseDoubleClick="EditFacility_Click">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Tên cơ sở" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="Địa chỉ" Binding="{Binding Address}" Width="*"/>
                            <DataGridTextColumn Header="Số kho" Binding="{Binding UnitCount}" Width="80"/>
                            <DataGridTextColumn Header="Còn trống" Binding="{Binding AvailableCount}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== ĐƠN THUÊ ===== -->
            <TabItem Header="Đơn thuê (xem)">
                <DockPanel Margin="12">
                    <Button DockPanel.Dock="Top" Content="Làm mới" HorizontalAlignment="Left" Click="Refresh_Click"/>
                    <DataGrid x:Name="gridRentals" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="*"/>
                            <DataGridTextColumn Header="Cơ sở" Binding="{Binding FacilityName}" Width="130"/>
                            <DataGridTextColumn Header="Kho" Binding="{Binding UnitCode}" Width="80"/>
                            <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="90"/>
                            <DataGridTextColumn Header="Kết thúc" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}" Width="90"/>
                            <DataGridTextColumn Header="Tổng tiền" Binding="{Binding Total, StringFormat={}{0:N0} ₫}" Width="120"/>
                            <DataGridTextColumn Header="Thanh toán" Binding="{Binding PaymentMethod}" Width="110"/>
                            <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
