<Window x:Class="SelfStorage.AdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SelfStore · Quản trị" Width="1380" Height="805" MinWidth="1060" MinHeight="675" Style="{StaticResource AppWindow}"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Đăng xuất" Click="Logout_Click" Margin="16,0,0,0"/>
                <TextBlock x:Name="lblUser" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <TabControl x:Name="Workspace" Style="{StaticResource WorkspaceTabs}" Tag="Quản trị">
            <TabItem Header="Tổng quan">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <TextBlock Text="Tổng quan" Style="{StaticResource TitleText}"/>
                    <TextBlock Text="Tình trạng kho hiện tại và phí thuê đã thu." Style="{StaticResource MutedText}" Margin="0,4,0,18"/>
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Kho còn trống" Style="{StaticResource MutedText}"/>
                                <TextBlock x:Name="lblAvailable" Style="{StaticResource MetricValue}" Foreground="{StaticResource Accent}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Kho đang thuê" Style="{StaticResource MutedText}"/>
                                <TextBlock x:Name="lblRented" Style="{StaticResource MetricValue}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Phí thuê đã thu" Style="{StaticResource MutedText}"/>
                                <TextBlock x:Name="lblStats" Style="{StaticResource MetricValue}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="lblRevenuePeriod" Style="{StaticResource MutedText}" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Làm mới" Click="Refresh_Click" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <StackPanel>
                                <Label Content="Chọn một ngày trong tháng thống kê" Target="{Binding ElementName=dpRevenueMonth}" Style="{StaticResource FieldLabel}"/>
                                <DatePicker x:Name="dpRevenueMonth" Width="160" HorizontalAlignment="Left" SelectedDateChanged="RevenueMonth_Changed"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <Button DockPanel.Dock="Right" Content="Mở danh sách đơn" Click="OpenRentals_Click" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Đơn cần xử lý" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <UniformGrid Columns="4">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Chờ nhận kho" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="lblPickup" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Quá hạn nhận" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="lblMissed" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Chờ kiểm tra" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="lblInspectionCount" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Chờ hoàn cọc" Style="{StaticResource MutedText}"/>
                                    <TextBlock x:Name="lblRefundCount" Style="{StaticResource MetricValue}"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                  </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ===== KHO ===== -->
            <TabItem Header="Quản lý kho">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                        <TextBlock Text="Quản lý kho" Style="{StaticResource TitleText}"/>
                        <TextBlock Text="Xem tình trạng, cập nhật thông tin và giá thuê của từng kho." Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Text="Vị trí" VerticalAlignment="Center"/>
                        <ComboBox x:Name="cbFilter" Width="200" Margin="6,0,16,0" DisplayMemberPath="Name"
                                  SelectionChanged="Filter_Changed"/>
                        <Button Content="Thêm kho" Style="{StaticResource PrimaryButton}" Click="AddUnit_Click"/>
                        <Button Content="Làm mới" Click="Refresh_Click"/>
                        <Button Content="Sửa kho" Click="EditUnit_Click"/>
                        <Button Content="Xóa kho" Style="{StaticResource DangerButton}" Click="DeleteUnit_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="gridUnits" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column"
                              MouseDoubleClick="EditUnit_Click">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" ElementStyle="{StaticResource TableText}"/>
                            <DataGridTextColumn Header="Vị trí" Binding="{Binding FacilityName}" Width="*" MinWidth="125" ElementStyle="{StaticResource TableText}"/>
                            <DataGridTextColumn Header="Mã kho" Binding="{Binding Code}" Width="100" ElementStyle="{StaticResource TableText}"/>
                            <DataGridTextColumn Header="Loại" Binding="{Binding Type}" Width="110" ElementStyle="{StaticResource TableText}"/>
                            <DataGridTextColumn Header="Diện tích (m²)" Binding="{Binding SizeM2}" Width="110" ElementStyle="{StaticResource TableText}"/>
                            <DataGridTextColumn Header="Giá / tháng" Binding="{Binding PricePerMonth, StringFormat={}{0:N2} ₫}" Width="140" ElementStyle="{StaticResource TableText}"/>
                            <DataGridTemplateColumn Header="Trạng thái" Width="165" SortMemberPath="StatusText" CellTemplate="{StaticResource StatusCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Khách hàng">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                        <TextBlock Text="Khách hàng" Style="{StaticResource TitleText}"/>
                        <TextBlock Text="Xem trạng thái và quản lý quyền truy cập của khách thuê." Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button Content="Khóa hoặc mở khóa" Click="ToggleCustomer_Click"/>
                        <Button Content="Làm mới" Click="Refresh_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="gridCustomers" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="*" ElementStyle="{StaticResource TableText}"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" ElementStyle="{StaticResource TableText}"/>
                            <DataGridTemplateColumn Header="Trạng thái" Width="150" SortMemberPath="AccountStatus" CellTemplate="{StaticResource AccountStatusCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ===== ĐƠN THUÊ ===== -->
            <TabItem x:Name="RentalsTab" Header="Đơn thuê">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,15">
                        <TextBlock Text="Đơn thuê" Style="{StaticResource TitleText}"/>
                        <TextBlock Text="Bàn giao, kiểm tra trả kho và đối soát tiền cọc." Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Button Content="Làm mới" Click="Refresh_Click"/>
                        <Button Content="Bàn giao bằng QR" Style="{StaticResource PrimaryButton}" Click="Receive_Click"/>
                        <Button Content="Kiểm tra trả kho" Click="Inspect_Click"/>
                        <Button Content="Xử lý đơn ngoại lệ" Click="StartReturn_Click"/>
                        <Button Content="Xác nhận hoàn cọc" Click="Refund_Click"/>
                    </WrapPanel>
                    <DataGrid x:Name="gridRentals" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding Id}" Width="50" ElementStyle="{StaticResource TableText}"/>
                            <DataGridTextColumn Header="Khách hàng" Binding="{Binding CustomerName}" Width="*" MinWidth="125" ElementStyle="{StaticResource TableText}"/>
                            <DataGridTextColumn Header="Vị trí" Binding="{Binding FacilityName}" Width="120" ElementStyle="{StaticResource TableText}"/>
                            <DataGridTextColumn Header="Kho" Binding="{Binding UnitCode}" Width="72" ElementStyle="{StaticResource TableText}"/>
                            <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="106" ElementStyle="{StaticResource TableText}"/>
                            <DataGridTextColumn Header="Kết thúc" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}" Width="106" ElementStyle="{StaticResource TableText}"/>
                            <DataGridTemplateColumn Header="Thanh toán" Width="128" SortMemberPath="PaidAmount">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="11,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PaymentStatusText}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                            <TextBlock Text="{Binding PaidAmount, StringFormat={}{0:N2} ₫, TargetNullValue=—}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Trạng thái" Width="165" SortMemberPath="StatusText" CellTemplate="{StaticResource StatusCell}"/>
                            <DataGridTextColumn Header="Đối soát cọc" Binding="{Binding RefundText}" Width="156" ElementStyle="{StaticResource TableText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
