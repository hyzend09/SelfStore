<Window x:Class="SelfStorage.BookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đặt kho" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock x:Name="lblInfo" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="lblPrice" Foreground="Gray" Margin="0,2,0,14"/>

        <TextBlock Text="Ngày bắt đầu"/>
        <DatePicker x:Name="dpStart" Margin="0,2,0,10" SelectedDateChanged="Recalc"/>

        <TextBlock Text="Thời gian thuê (tháng)"/>
        <ComboBox x:Name="cbMonths" Margin="0,2,0,14" SelectionChanged="Recalc"/>

        <Border BorderBrush="#DDD" BorderThickness="1" Padding="10" CornerRadius="4">
            <StackPanel>
                <TextBlock x:Name="lblEnd"/>
                <TextBlock x:Name="lblRent"/>
                <TextBlock x:Name="lblDeposit"/>
                <TextBlock x:Name="lblTotal" FontWeight="Bold" FontSize="16" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Hủy" IsCancel="True"/>
            <Button Content="Thanh toán" Click="Pay_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
