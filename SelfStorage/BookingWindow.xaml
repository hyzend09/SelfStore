<Window x:Class="SelfStorage.BookingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SelfStore · Đặt kho" Width="492" SizeToContent="Height" MaxHeight="700"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25">
            <TextBlock Text="Đặt kho" Style="{StaticResource TitleText}"/>
            <TextBlock x:Name="lblInfo" Style="{StaticResource SectionTitle}" Margin="0,9,0,0"/>
            <TextBlock x:Name="lblPrice" Style="{StaticResource MutedText}" Margin="0,3,0,20"/>
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <Label Content="Ngày bắt đầu" Target="{Binding ElementName=dpStart}" Style="{StaticResource FieldLabel}"/>
                    <DatePicker x:Name="dpStart" SelectedDateChanged="Recalc"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <Label Content="Thời gian thuê (tháng)" Target="{Binding ElementName=cbMonths}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="cbMonths" SelectionChanged="Recalc"/>
                </StackPanel>
            </Grid>
            <Border Style="{StaticResource SoftPanel}">
                <StackPanel>
                    <TextBlock x:Name="lblEnd" Style="{StaticResource MutedText}" Margin="0,0,0,7"/>
                    <TextBlock x:Name="lblRent" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock x:Name="lblDeposit" TextWrapping="Wrap"/>
                    <Separator Margin="0,10"/>
                    <TextBlock x:Name="lblTotal" Style="{StaticResource SectionTitle}" Foreground="{StaticResource Accent}"/>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Hủy" IsCancel="True"/>
                <Button Content="Giữ kho 15 phút và thanh toán" Click="Pay_Click" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Margin="0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
