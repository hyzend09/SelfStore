<Window x:Class="SelfStorage.FacilityEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Tên cơ sở"/>
        <TextBox x:Name="txtName" Margin="0,2,0,8" Padding="4"/>
        <TextBlock Text="Địa chỉ"/>
        <TextBox x:Name="txtAddress" Margin="0,2,0,8" Padding="4"/>
        <TextBlock x:Name="lblError" Foreground="Red" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Hủy" IsCancel="True"/>
            <Button Content="Lưu" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
