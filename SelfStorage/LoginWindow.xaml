<Window x:Class="SelfStorage.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SelfStore · Đăng nhập" Width="850" Height="590" MinWidth="730" MinHeight="555"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.87*"/><ColumnDefinition Width="1.13*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource Nav}" Padding="32">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Border Background="{StaticResource Mint}" Width="40" Height="40" CornerRadius="9">
                        <Path Width="22" Height="22" Stretch="Uniform" Stroke="{StaticResource Nav}" StrokeThickness="1.8"
                              Data="M1,7 L11,1 21,7 21,17 11,23 1,17 Z M1,7 L11,13 21,7 M11,13 L11,23 M6,4 L16,10"/>
                    </Border>
                    <TextBlock Text="SelfStore" Foreground="White" FontSize="22" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <TextBlock Text="Tài khoản demo" Foreground="{StaticResource Mint}" FontWeight="SemiBold"/>
                    <TextBlock Text="Khách: demo@demo.com / 123456" Foreground="{StaticResource NavText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="Admin: admin@demo.com / admin123" Foreground="{StaticResource NavText}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <Path Width="82" Height="82" HorizontalAlignment="Left" Stretch="Uniform" Stroke="{StaticResource Mint}"
                          StrokeThickness="1.5" Data="M1,7 L11,1 21,7 21,17 11,23 1,17 Z M1,7 L11,13 21,7 M11,13 L11,23 M6,4 L16,10"/>
                    <TextBlock Style="{StaticResource TitleText}" Foreground="White" FontSize="37" Margin="0,18,0,0">
                        <Run Text="Thuê kho"/><LineBreak/><Run Text="tự phục vụ"/>
                    </TextBlock>
                    <TextBlock Text="Tìm kho, đặt chỗ và theo dõi đơn thuê." Foreground="{StaticResource NavText}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" Background="{StaticResource Surface}" VerticalScrollBarVisibility="Auto">
            <StackPanel Width="335" HorizontalAlignment="Center" Margin="22,46,22,26">
                <TextBlock Text="Tài khoản SelfStore" Style="{StaticResource TitleText}" Margin="0,0,0,20"/>
                <TabControl x:Name="AccountTabs" Style="{StaticResource FormTabs}">
                    <TabItem Header="Đăng nhập">
                        <StackPanel>
                            <Label Content="Email" Target="{Binding ElementName=txtLoginEmail}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtLoginEmail" Margin="0,0,0,14" MaxLength="320"/>
                            <Label Content="Mật khẩu" Target="{Binding ElementName=txtLoginPass}" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="txtLoginPass" Margin="0,0,0,18"/>
                            <Button Content="Đăng nhập" Click="Login_Click" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Đăng ký">
                        <StackPanel>
                            <Label Content="Họ tên" Target="{Binding ElementName=txtRegName}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtRegName" Margin="0,0,0,12" MaxLength="200"/>
                            <Label Content="Email" Target="{Binding ElementName=txtRegEmail}" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="txtRegEmail" Margin="0,0,0,12" MaxLength="320"/>
                            <Label Content="Mật khẩu" Target="{Binding ElementName=txtRegPass}" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="txtRegPass" Margin="0,0,0,18"/>
                            <Button Content="Tạo tài khoản" Click="Register_Click" IsDefault="True" Style="{StaticResource PrimaryButton}" Margin="0"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
                <TextBlock x:Name="lblMsg" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,12,0,0"
                           AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
