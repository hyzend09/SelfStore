<Window x:Class="SelfStorage.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Self Storage" Width="380" Height="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="SELF STORAGE" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#2D5BFF"/>
        <TabControl Margin="0,16,0,0">
            <TabItem Header="Đăng nhập">
                <StackPanel Margin="12">
                    <TextBlock Text="Email"/>
                    <TextBox x:Name="txtLoginEmail" Margin="0,2,0,8" Padding="4"/>
                    <TextBlock Text="Mật khẩu"/>
                    <PasswordBox x:Name="txtLoginPass" Margin="0,2,0,12" Padding="4"/>
                    <Button Content="Đăng nhập" Click="Login_Click" IsDefault="True"/>
                    <TextBlock Text="Khách: demo@demo.com / 123456   |   Admin: admin@demo.com / admin123" Foreground="Gray" FontSize="11" Margin="4,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Đăng ký">
                <StackPanel Margin="12">
                    <TextBlock Text="Họ tên"/>
                    <TextBox x:Name="txtRegName" Margin="0,2,0,8" Padding="4"/>
                    <TextBlock Text="Email"/>
                    <TextBox x:Name="txtRegEmail" Margin="0,2,0,8" Padding="4"/>
                    <TextBlock Text="Mật khẩu"/>
                    <PasswordBox x:Name="txtRegPass" Margin="0,2,0,12" Padding="4"/>
                    <Button Content="Tạo tài khoản" Click="Register_Click"/>
                </StackPanel>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="lblMsg" Foreground="Red" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel>
</Window>
