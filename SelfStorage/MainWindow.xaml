<Window x:Class="SelfStorage.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SelfStorage"
        Title="SelfStore · Khách hàng" Width="1200" Height="750" MinWidth="930" MinHeight="640"
        Style="{StaticResource AppWindow}" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Đăng xuất" Click="Logout_Click" Margin="16,0,0,0"/>
                <TextBlock x:Name="lblUser" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <TabControl x:Name="Tabs" Style="{StaticResource WorkspaceTabs}" Tag="Khách hàng" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Tìm kho"><local:BrowseView x:Name="browse"/></TabItem>
            <TabItem Header="Kho của tôi"><local:MyRentalsView x:Name="mine"/></TabItem>
        </TabControl>
    </DockPanel>
</Window>
