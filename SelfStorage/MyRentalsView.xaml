<UserControl x:Class="SelfStorage.MyRentalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock x:Name="lblDetails" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Làm mới" Click="Refresh_Click"/>
                <Button x:Name="btnPayHold" Content="Thanh toán đơn" Click="PayHold_Click" IsEnabled="False"/>
                <Button x:Name="btnCancelHold" Content="Hủy giữ chỗ" Click="CancelHold_Click" IsEnabled="False"/>
                <Button x:Name="btnQr" Content="Xem mã QR" Click="Qr_Click" IsEnabled="False"/>
                <Button x:Name="btnReturn" Content="Yêu cầu trả kho" Click="Return_Click" IsEnabled="False"/>
            </StackPanel>
        </StackPanel>
        <DataGrid x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" HeadersVisibility="Column" SelectionChanged="Rental_Changed">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã thuê" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="Cơ sở" Binding="{Binding FacilityName}" Width="*"/>
                <DataGridTextColumn Header="Kho" Binding="{Binding UnitCode}" Width="90"/>
                <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                <DataGridTextColumn Header="Kết thúc" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                <DataGridTextColumn Header="Đã thanh toán" Binding="{Binding PaidAmount, StringFormat={}{0:N2} ₫}" Width="130"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="170"/>
                <DataGridTextColumn Header="Đối soát cọc" Binding="{Binding RefundText}" Width="180"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
