<UserControl x:Class="SelfStorage.MyRentalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Làm mới" Click="Refresh_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <StackPanel>
                <TextBlock Text="Kho của tôi" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Theo dõi đơn thuê, mã QR và tiền cọc." Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border x:Name="rentalDetails" DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12"
                Visibility="Collapsed">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Border x:Name="detailStatus" DockPanel.Dock="Right" Style="{StaticResource StatusPill}" Margin="12,0,0,0">
                        <TextBlock x:Name="lblStatus" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock x:Name="lblOrder" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <ScrollViewer MaxHeight="105" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="lblDetails" Style="{StaticResource MutedText}" LineHeight="21"
                               AutomationProperties.LiveSetting="Polite"/>
                </ScrollViewer>
                <WrapPanel x:Name="rentalActions" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <WrapPanel.Resources>
                        <BooleanToVisibilityConverter x:Key="ShowAvailableAction"/>
                    </WrapPanel.Resources>
                    <Button x:Name="btnCancelHold" Content="Hủy giữ chỗ" Click="CancelHold_Click" IsEnabled="False"
                            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ShowAvailableAction}}"/>
                    <Button x:Name="btnQr" Content="Xem mã QR" Click="Qr_Click" IsEnabled="False"
                            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ShowAvailableAction}}"/>
                    <Button x:Name="btnReturn" Content="Yêu cầu trả kho" Click="Return_Click" IsEnabled="False"
                            Style="{StaticResource PrimaryButton}" Margin="0"
                            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ShowAvailableAction}}"/>
                    <Button x:Name="btnPayHold" Content="Thanh toán đơn" Click="PayHold_Click" IsEnabled="False"
                            Style="{StaticResource PrimaryButton}" Margin="0"
                            Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource ShowAvailableAction}}"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <Grid>
          <DataGrid x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" HeadersVisibility="Column" SelectionChanged="Rental_Changed" AutomationProperties.Name="Đơn thuê của tôi">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã đơn" Binding="{Binding Id, StringFormat={}#{0}}" Width="70" ElementStyle="{StaticResource TableCode}"/>
                <DataGridTextColumn Header="Kho" Binding="{Binding UnitCode}" Width="80" ElementStyle="{StaticResource TableCode}"/>
                <DataGridTextColumn Header="Vị trí" Binding="{Binding FacilityName}" Width="*" MinWidth="100" ElementStyle="{StaticResource TableText}"/>
                <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="88" ElementStyle="{StaticResource TableText}"/>
                <DataGridTextColumn Header="Kết thúc" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}" Width="88" ElementStyle="{StaticResource TableText}"/>
                <DataGridTextColumn Header="Đã thanh toán" Binding="{Binding PaidAmount, StringFormat={}{0:N2} ₫, TargetNullValue=—}" Width="120" ElementStyle="{StaticResource TableAmount}"/>
                <DataGridTemplateColumn Header="Trạng thái" Width="163" MinWidth="155" SortMemberPath="StatusText" CellTemplate="{StaticResource StatusCell}"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel x:Name="emptyRentals" Visibility="Collapsed" Margin="16,52,16,12" IsHitTestVisible="False"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="Bạn chưa có đơn thuê" Style="{StaticResource SectionTitle}" TextAlignment="Center"/>
              <TextBlock Text="Vào mục Tìm kho để chọn kho và đặt chỗ." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,0"/>
          </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
