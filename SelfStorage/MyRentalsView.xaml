<UserControl x:Class="SelfStorage.MyRentalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Xem mã QR" Click="Qr_Click"/>
            <Button Content="Trả kho" Click="Return_Click"/>
        </StackPanel>
        <DataGrid x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã thuê" Binding="{Binding Id}" Width="70"/>
                <DataGridTextColumn Header="Cơ sở" Binding="{Binding FacilityName}" Width="*"/>
                <DataGridTextColumn Header="Kho" Binding="{Binding UnitCode}" Width="90"/>
                <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                <DataGridTextColumn Header="Kết thúc" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}" Width="100"/>
                <DataGridTextColumn Header="Đã thanh toán" Binding="{Binding Total, StringFormat={}{0:N0} ₫}" Width="130"/>
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
