<UserControl x:Class="SelfStorage.MyRentalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Content="Làm mới" Click="Refresh_Click" VerticalAlignment="Center" Margin="12,0,0,0"/>
            <StackPanel>
                <TextBlock Text="Kho của tôi" Style="{StaticResource TitleText}"/>
                <TextBlock Text="Theo dõi đơn thuê, mã QR và tiền cọc." Style="{StaticResource MutedText}" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10">
            <StackPanel>
                <TextBlock Text="Chi tiết đơn" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ScrollViewer MaxHeight="116" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="lblDetails" Style="{StaticResource MutedText}"/>
                </ScrollViewer>
                <WrapPanel HorizontalAlignment="Right" Margin="0,9,0,0">
                    <Button x:Name="btnCancelHold" Content="Hủy giữ chỗ" Click="CancelHold_Click" IsEnabled="False"/>
                    <Button x:Name="btnQr" Content="Xem mã QR" Click="Qr_Click" IsEnabled="False"/>
                    <Button x:Name="btnReturn" Content="Yêu cầu trả kho" Click="Return_Click" IsEnabled="False"/>
                    <Button x:Name="btnPayHold" Content="Thanh toán đơn" Click="PayHold_Click" IsEnabled="False"
                            Style="{StaticResource PrimaryButton}" Margin="0"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <DataGrid x:Name="grid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" HeadersVisibility="Column" SelectionChanged="Rental_Changed" AutomationProperties.Name="Đơn thuê của tôi">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã đơn" Binding="{Binding Id, StringFormat={}#{0}}" Width="70" ElementStyle="{StaticResource TableCode}"/>
                <DataGridTextColumn Header="Kho" Binding="{Binding UnitCode}" Width="80" ElementStyle="{StaticResource TableCode}"/>
                <DataGridTextColumn Header="Vị trí" Binding="{Binding FacilityName}" Width="*" MinWidth="107" ElementStyle="{StaticResource TableText}"/>
                <DataGridTextColumn Header="Bắt đầu" Binding="{Binding StartDate, StringFormat=dd/MM/yyyy}" Width="106" ElementStyle="{StaticResource TableText}"/>
                <DataGridTextColumn Header="Kết thúc" Binding="{Binding EndDate, StringFormat=dd/MM/yyyy}" Width="106" ElementStyle="{StaticResource TableText}"/>
                <DataGridTextColumn Header="Đã thanh toán" Binding="{Binding PaidAmount, StringFormat={}{0:N2} ₫, TargetNullValue=—}" Width="128" ElementStyle="{StaticResource TableText}"/>
                <DataGridTemplateColumn Header="Trạng thái" Width="163" SortMemberPath="StatusText" CellTemplate="{StaticResource StatusCell}"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
