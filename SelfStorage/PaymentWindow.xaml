<Window x:Class="SelfStorage.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SelfStore · Thanh toán" Width="460" SizeToContent="Height" MaxHeight="700"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25">
            <TextBlock Text="Thanh toán" Style="{StaticResource TitleText}" Margin="0,0,0,14"/>
            <Border Style="{StaticResource SoftPanel}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Số tiền cần thanh toán" Style="{StaticResource MutedText}"/>
                    <TextBlock x:Name="lblAmount" Style="{StaticResource MetricValue}" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="lblDeadline" Style="{StaticResource MutedText}" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Phương thức thanh toán" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <RadioButton x:Name="rbCard" Content="Thẻ ngân hàng" IsChecked="True"/>
            <RadioButton x:Name="rbWallet" Content="Ví điện tử (MoMo / ZaloPay)"/>
            <RadioButton x:Name="rbTransfer" Content="Chuyển khoản"/>
            <TextBlock Text="Thanh toán mô phỏng. Bạn có thể tiếp tục từ Kho của tôi trước khi hết hạn giữ chỗ."
                       Style="{StaticResource MutedText}" Margin="0,9,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Để sau" IsCancel="True"/>
                <Button x:Name="btnPay" Content="Xác nhận thanh toán" Click="Confirm_Click" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" Margin="0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
