<Window x:Class="SelfStorage.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SelfStore · Thanh toán" Width="494" SizeToContent="Height" MaxHeight="700"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="{StaticResource Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="24">
            <TextBlock Text="Thanh toán" Style="{StaticResource TitleText}" Margin="0,0,0,14"/>
            <Border Style="{StaticResource Card}" Background="{StaticResource AccentSoft}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Số tiền cần thanh toán" FontWeight="SemiBold"/>
                    <TextBlock x:Name="lblAmount" Style="{StaticResource MetricValue}" Foreground="{StaticResource Accent}" TextWrapping="Wrap"/>
                    <TextBlock x:Name="lblDeadline" Style="{StaticResource MutedText}" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite"/>
                    <TextBlock Text="Thanh toán mô phỏng" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Phương thức thanh toán" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border Style="{StaticResource Card}" Padding="14,4">
                <StackPanel>
                    <RadioButton x:Name="rbCard" Content="Thẻ ngân hàng" IsChecked="True" MinHeight="40"/>
                    <Separator Margin="0"/>
                    <RadioButton x:Name="rbWallet" Content="Ví điện tử (MoMo / ZaloPay)" MinHeight="40"/>
                    <Separator Margin="0"/>
                    <RadioButton x:Name="rbTransfer" Content="Chuyển khoản" MinHeight="40"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Bạn có thể tiếp tục thanh toán từ Kho của tôi trước khi hết hạn giữ chỗ."
                       Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="1" Background="{StaticResource Canvas}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Để sau" IsCancel="True"/>
                    <Button x:Name="btnPay" Content="Xác nhận thanh toán" Click="Confirm_Click" IsDefault="True" MinWidth="173"
                            Style="{StaticResource PrimaryButton}" Margin="0"/>
                </WrapPanel>
                <ProgressBar x:Name="paymentProgress" IsIndeterminate="True" Visibility="Collapsed" Height="4" Margin="0,0,16,0"
                             Foreground="{StaticResource Accent}" AutomationProperties.Name="Đang xử lý thanh toán"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
