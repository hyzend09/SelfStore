<Window x:Class="SelfStorage.QrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mã QR nhận kho" Width="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20" HorizontalAlignment="Center">
        <TextBlock x:Name="lblTitle" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" MaxWidth="300" TextWrapping="Wrap" TextAlignment="Center"/>
        <TextBlock x:Name="lblSub" Foreground="Gray" HorizontalAlignment="Center" Margin="0,2,0,10" TextAlignment="Center"/>
        <Image x:Name="imgQr" Width="240" Height="240"/>
        <TextBlock Text="Xuất trình mã này tại cơ sở để nhận kho" Foreground="Gray" FontSize="11"
                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
        <TextBox x:Name="txtQrContent" IsReadOnly="True" TextWrapping="Wrap" MaxWidth="300" Margin="0,8,0,0"/>
        <TextBlock Text="Xuất trình QR cho nhân viên khi nhận kho. Có thể sao chép nội dung mã ở trên." TextWrapping="Wrap" MaxWidth="300" Foreground="Gray" Margin="0,6,0,0"/>
        <Button Content="Đóng" IsDefault="True" IsCancel="True" HorizontalAlignment="Center" Margin="0,12,0,0"/>
    </StackPanel>
</Window>
