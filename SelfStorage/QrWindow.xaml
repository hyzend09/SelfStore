<Window x:Class="SelfStorage.QrWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SelfStore · Mã QR đơn thuê" Width="428" SizeToContent="Height" MaxHeight="700"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource Surface}">
        <StackPanel Margin="24">
            <TextBlock Text="Mã QR đơn thuê" Style="{StaticResource TitleText}" TextAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock x:Name="lblTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock x:Name="lblSub" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,4,0,12"/>
            <Border Style="{StaticResource Card}" HorizontalAlignment="Center" Padding="8">
                <Image x:Name="imgQr" Width="200" Height="200" AutomationProperties.Name="Mã QR dùng khi nhận và trả kho"/>
            </Border>
            <TextBlock Text="Xuất trình mã cho Admin khi nhận và trả kho." Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,13,0,8"/>
            <TextBox x:Name="txtQrContent" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Nội dung mã QR"/>
            <TextBlock x:Name="lblCopy" Foreground="{StaticResource Accent}" Margin="0,5,0,0" AutomationProperties.LiveSetting="Polite" TextAlignment="Right"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Đóng" IsDefault="True" IsCancel="True"/>
                <Button Content="Sao chép mã" Click="Copy_Click" Style="{StaticResource PrimaryButton}" Margin="0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
