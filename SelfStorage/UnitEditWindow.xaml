<Window x:Class="SelfStorage.UnitEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Cơ sở"/>
        <ComboBox x:Name="cbFacility" DisplayMemberPath="Name" Margin="0,2,0,8"/>
        <TextBlock Text="Mã kho"/>
        <TextBox x:Name="txtCode" Margin="0,2,0,8" Padding="4"/>
        <TextBlock Text="Loại kho (chọn hoặc gõ mới)"/>
        <ComboBox x:Name="cbType" IsEditable="True" Margin="0,2,0,8"/>
        <TextBlock Text="Diện tích (m²)"/>
        <TextBox x:Name="txtSize" Margin="0,2,0,8" Padding="4"/>
        <TextBlock Text="Giá thuê / tháng (₫)"/>
        <TextBox x:Name="txtPrice" Margin="0,2,0,8" Padding="4"/>
        <CheckBox x:Name="chkAvail" Content="Còn trống (sẵn sàng cho thuê)" IsChecked="True" Margin="0,2,0,0"/>
        <TextBlock x:Name="lblNote" Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
        <TextBlock x:Name="lblError" Foreground="Red" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Hủy" IsCancel="True"/>
            <Button Content="Lưu" Click="Save_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
